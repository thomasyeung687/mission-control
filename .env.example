# Anthropic API key (console.anthropic.com → API keys). Billed per token.
ANTHROPIC_API_KEY=
# Fine-grained GitHub token with Contents: Read and write on the repos agents work on.
GITHUB_TOKEN=
# Password for the dashboard login.
MISSION_CONTROL_PASSWORD=
# Optional: secret used to sign the login cookie (defaults to the password).
MISSION_CONTROL_SECRET=
# Optional: reuse an existing Managed Agents environment instead of the auto-created "mission-control" one.
MISSION_CONTROL_ENVIRONMENT_ID=
# Optional: GitHub owner used to expand short repo names ("golf-native" → owner/golf-native).
GITHUB_DEFAULT_OWNER=thomasyeung687
# Set to 1 to run against built-in fixtures instead of the real API.
MOCK=
# Optional: workspace ID for "Console ↗" links on runs (defaults to the Default workspace).
ANTHROPIC_WORKSPACE_ID=
# Optional: comma-separated repos offered as suggestions on the New run form.
MISSION_CONTROL_REPOS=thomasyeung687/golf-native
